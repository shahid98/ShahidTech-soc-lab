<group name="windows,windows_security,authentication_failed,">
  <rule id="100100" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID" type="pcre2">^4625$</field>
    <field name="win.eventdata.subStatus" type="pcre2">(?i)^0xc000006a$</field>
    <description>Windows logon failed due to an incorrect password</description>
  </rule>
</group>
